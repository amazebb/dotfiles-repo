[init]
    defaultBranch = master
    defaultObjectFormat = sha1

[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    pager = "dh=\"$(git --exec-path)/../../share/git-core/contrib/diff-highlight/diff-highlight\"; if command -v delta >/dev/null 2>&1; then delta --tui; elif command -v bat >/dev/null 2>&1; then \"$dh\" | bat; else \"$dh\" | less -FRX; fi"

[user]
    name = bb
    email = 26394523+broeknbytes@users.noreply.github.com

[github]
    user = amazebb

[diff]
    colorMoved = default
    context = 1

[difftool]
    prompt = false

[alias]
    c = commit
    cv = commit -v
    cva = commit -va
    co = checkout
    d = diff
    pom = push origin master
    s = status
    dw = diff --word-diff-regex='\\w+|[^[:space:]]'
    dc = diff --color-words=.

[credential "https://github.com"]
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper = !gh auth git-credential

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    hyperlinks = true
    hunk-header-style = omit
    log-args = --stat
    log-args = --date=relative
    file-header = stat
    start-folded = true

[merge]
    conflictStyle = zdiff3

[pager]
    diff = delta --tui
    show = delta --tui
    log = delta --tui

